[Unit]
Description=@PROJECT@ (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=cloudops
Group=cloudops
EnvironmentFile=/etc/@PROJECT@/app.env
# t3.micro(1GB) 向けにヒープを抑える。jar は CD が /opt/@PROJECT@/app.jar へ配備する。
# ExecStart は run.sh 経由。起動毎に Secrets Manager の現行 DB パスワードを取り直して
# app.env の焼き込み値の陳腐化（マネージドパスワードの自動更新）に耐える。
ExecStart=/opt/@PROJECT@/run.sh
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
